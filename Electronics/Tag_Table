DI_Cyl2_Home           Bool         %I1.0      Janatics Ejector 2 Home Limit Switch
DI_Air_Pressure_OK     Bool         %I1.1      Pneumatic Pressure Interlock (>= 5.5 bar)

DO_Motor_Run           Bool         %Q0.0      Conveyor 24V Drive Motor Run
DO_Ejector1_Metal      Bool         %Q0.1      Pneumatic Valve 1 Solenoid (Metal)
